        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cuci bersih cabe

kupas bawang merah lalu potong kecil 

tumis terasi dengan minyak panas sampai harum 

haluskan cabe keriting, cabe rawit, bawang merah,  terasi dan garam 

tambahkan asam jawa yang telah dibuang matanya, haluskan 

tuangi miyak panas , lalu hidangkan segera</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jawa Timur</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses membuat sambal brambang asem sangat cepat, hanya membutuhkan waktu sekitar 5 hingga 10 menit mulai dari merebus bahan, mengulek di cobek, hingga mencampurnya dengan asam jawa.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pisau
Cobek dan ulekan 
chopper  
panci 
wajan
spatula</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabai keriting, cabai rawit, bawang merah, asam jawa, terasi udang, minyak panas</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nasi, dadar telur</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Brambang Asem</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ditumis dan diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas Sedang</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 buah cabe keriting
- 5 buah cabe rawit
- 3 buah bawang merah 
- 3 mata asam jawa 
- 1 sdt terasi udang 
- 3 sdm minyak panas</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah Tua</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalBrambangAsem</rdfs:label>
    </owl:NamedIndividual>
    


