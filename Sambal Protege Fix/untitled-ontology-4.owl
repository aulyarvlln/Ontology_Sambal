        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- bersihkan udang lalu goreng dengan sedikit minyak sampai matang 
- iris cabai, bawnag merah, belimbing wulih, serai, dan daun jeruk
- ulek cabai dan bawang merah hingga agak kasar
- masukkan belimbing wuluh dan udang, lalu ulek kembali 
- tambahkan serai dan daun jeruk
- beri garam dan gula, kemudian aduk rata</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Aceh</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses membuat sambal ganja sangat cepat, hanya memerlukan waktu sekitar 5 hingga 10 menit karena semua bahannya langsung diulek mentah tanpa perlu dimasak atau direbus.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cobek
ulekan
pisau
talenan 
wajan
spatula
mangkuk</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Udang kupas, cabai rawit, bawang merah, belimbing wuluh, seraii, daun jeruk, serai, garam, gula, minyak goreng</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nasi putih, ikan bakar, ikan goreng, ayam goreng dan lauk lain</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Ganja</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diiris lalu diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sangat Pedas</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 100 gram udang kupas
- 15 buah cabe rawit 
- 6 siung bawang merah 
- 5 buah belimbing wuluh 
- 3 batang serai  
- 6 lembar daun jeruk
- 1/2 sdt garam
- 1/4 sdt gula
- 2 sdm minyak goreng</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cokelat kehijauan, oranye</WarnaSambal>
        <rdfs:label>SambalGanja</rdfs:label>
