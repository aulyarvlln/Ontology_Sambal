        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cuci bersih cabe merah keriting, cabe rawit, cabe lalap, dan tomat 
- kupas bawang merah dan potong tipis
- potong-potong ketiga jenis cabe berbentuk bulat
- potong-potong tomat mengkal dalam ukuran yang serasi dengan cabe dan bawang merah
- masukkan semua bahan sambal ke dalam mangkuk
- berikan garam dan air perasan air jeruk sambal, aduk rata
- tuangkan minyak panas dan aduk kembali
- sambal siap dihidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manado</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">5 sampai 10 menit</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pisau, mangkuk, talenan, wajan, dan spatula</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cabe merah keriting, cabe rawit hijau/merah, bawang merah, tomat mengkal, garam, jeruk sambal, dan minyak panas</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ikan Bakar</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Dabu-dabu</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">diiris dan isiram minyak panas</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">segar, pedas, dan asam</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 7 buah cabe merah keriting
- 9 buah cabe rawit orange/merah 
- 5 buah bawang merah 
- 2 buah tomat mengkal 
- 1 sdt garam 
- 2 buah jeruk sambal 
- 2 sdm minyak panas</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">tomat memberikan warna merah dan hijau yang segar, cabe rawit dan cabe merah keriting menambahkan warna merah dan hijau terang, bawang merah memberikan warna keunguan/merah pucat yang khas.</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalDabu-Dabu</rdfs:label>
    </owl:NamedIndividual>
    


