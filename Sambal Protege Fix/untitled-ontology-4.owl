        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi dengan aneka ragam lauk pauk seperti Ayam Goreng, Lele Goreng, Bebek Goreng, Tahu dan Tempe</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Kemangi</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">DIsiram minyak panas lalu dihaluskan dengan cara diulek</NamaTeknik>
