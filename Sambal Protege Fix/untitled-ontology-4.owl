        <DisajikanUntuk rdf:resource="http://webprotege.stanford.edu/RByLiNErlIm1D5bD9xHgRGI"/>
        <MenggunakanBahanPedas rdf:resource="http://www.semanticweb.org/aulia/ontologies/2026/8/untitled-ontology-4#CabaiBesarMerah"/>
