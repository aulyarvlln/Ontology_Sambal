- garam</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nasi soto ayam, soto daging</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Rebus</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Direbus</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perpaduan pedas yang tajam, segar alami, sedikit manis, dan gurih</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 cabe merah tanpa biji, 
- 3 cabe rawit
- 1 siung bawng putih
- 2 bawang merah
1/2 sdt garam</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Halus, berair (basah)</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merah cerah cenderung pucat (matte), jernih, dan tidak mengkilap</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalRebus</rdfs:label>
    </owl:NamedIndividual>
    


