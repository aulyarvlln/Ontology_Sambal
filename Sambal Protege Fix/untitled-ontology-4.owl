        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">suwir daging ikan roa, buang kulit dan durinya, sisihkan

cuci bersih cabe merah, cabe rawit, dan tomat 

potong potong tomat dalam ukuran kecil 

kupas bawang merah dan bawang putih, potong tipis 

haluskan cabe merah, cabe rawit, bawang merah, bawang putih, garam, gula pasir

tumis bumbu halus, tambahkan potongan tomat dan ikan roa 

masak sampai harum dan sedikit kering

makanlah</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manado</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses membuat sambal ikan roa membutuhkan waktu total sekitar 30 hingga 40 menit, karena daging ikan roa asap harus dikupas, disuwir, dan dihaluskan terlebih dahulu sebelum ditumis bersama bumbu halus dengan api kecil selama 15 hingga 20 menit agar matang tanak dan awet.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pisau 
talenan
cobek 
ulekan 
wajan
spatula
chopper</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ikan roa, cabai merah, cabai rawit merah, bawang merah, bawang putih, tomat, garam, gula pasir, minyak goreng</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bubur Manado</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Ikan Roa</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ditumis</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas Sedang</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 150 gram ikan roa asap
- 15 buah cabe merah
- 3 buah cabai rawit
- 10 buah bawang merah 
- 6 buah bawang putih 
- 1 buah tomat 
- 1 sdt garam 
- 2 sdt gula pasir 
- 60 ml minyak goreng</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah tua kecoklatan</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalIkanRoa</rdfs:label>
    </owl:NamedIndividual>
    


