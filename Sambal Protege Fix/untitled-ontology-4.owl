        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 cabe merah tanpa biji,
- 3 cabe rawit,
- 1 siung bawang putih
- 1 sdm tauco,
- 1 sdm gula aren
- minyak goreng secukupnya, 
- 3 sdm air masak
- 1 sdt garam</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cokelat muda kekuningan, cokelat tua kemerahan, hingga hijau kecokelatan</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalTauco</rdfs:label>
    </owl:NamedIndividual>
    


