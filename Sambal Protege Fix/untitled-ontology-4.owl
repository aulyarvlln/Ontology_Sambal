        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 sampai 15 menit</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ulekan, cobek, pisau, dan talenan</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cabe merah keriting, cabe rawit, bawang merah, nanas kupas, garam, gula pasir, cuka makan</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mie Kuah dan Nasi Goreng</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Nanas</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nanas diiris, bahan lainnya diulek, lalu dicampur</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pedas, manis, asam, dan segar</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 10 buah cabe merah keriting
- 5 buah cabe rawit lalap
- 5 buah bawang merah 
- 25 gram nanas kupas 
- 1/2 sdt garam 
- 1 sdt gula pasir 
- 1 sdt cuka makan</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merah dari cabe, kuning atau keemasan dari potongan nanas</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalNanas</rdfs:label>
    </owl:NamedIndividual>
    


