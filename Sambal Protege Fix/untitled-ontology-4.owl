        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cuci bersih cabe keriting dan cabe lalap

- goreng tahu kuning atau tahu pong sampai matang

- tumis cabe keriting, cabe lalap, dan terasi

- haluskan bahan yang tekah ditumis bersama gula dan garam

- masukkan tahu goreng, tumbuk kasar, aduk

- sambal tahu siap dihidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indonesia</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 sampai 15 menit</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">wajan, ulekan, cobek</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cabe keriting
- cabe lalap
- tahu kuning
- tahu pong
- terasi
- garam
- gula merah
- minyak goreng</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi dan aneka olahan protein hewani atau nabati</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Tahu</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ditumis, Digoreng</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kombinasi pedas, gurih asin yang gurih, sedikit manis, serta tekstur lembut-lembut dari tahu</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 cabe keriting
- 3 cabe lalap
- 1 potong tahu kuning atau tahu pong
- 1/2 sdt terasi
- 1/2 sdt garam
- 1 sdt gula merah
- minyak goreng secukupnya</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merah cerah, merah tua kecokelatan, hingga cokelat kehitaman</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalTahu</rdfs:label>
    </owl:NamedIndividual>
    


