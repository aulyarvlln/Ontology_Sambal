        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- kupas bawang putih, cuci bersih bawang putih dan cabai
- goreng cabai dan bawang putih
- ulek bersama garam dan gula hingga kasar 
- siram dengan minyak panas lalu aduk rata
- siap dihidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jawa Tengah</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses pembuatan sambal bawang sangat cepat dan hanya membutuhkan waktu sekitar 5 hingga 10 menit. Pertama, siapkan bahan dengan mengupas bawang, mencuci cabai, lalu menguleknya secara kasar. Setelah itu, tumis semua bahan di dalam minyak panas menggunakan api sedang-kecil selama kurang lebih 5 menit sampai aromanya harum dan sambal matang sempurna.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cobek
ulekan
chopper
sendok
wajan
spatula</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cabai rawit, siung bawang putih, garam, gula, minyak goreng</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ayam goreng, ayam geprek, bebek goreng, nasi</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Bawang</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ditumis dan diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sangat Pedas</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 15 cabe rawit
- 3 siung bawang putih 
- 1/2 sdt garam 
- 1/4 sdt gula 
- 4 sdm minyak goreng</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah</WarnaSambal>
        <rdfs:label>SambalBawang</rdfs:label>
    </owl:NamedIndividual>
    


