        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- haluskan cabe. bawang, kemiri, kunyit, ,dan jahe

- tumis bumbu bersama serai, daun jeruk, dan daun pandan

- masukkan tomat dan garam

- masak sampai bumbu matang dan harum 

- tambahkan daun kemengi, aduk sebentar lalu angkat</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SulawesiUtara</AsalDaerah>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- Cobek
- Ulekan
- Blender 
- Pisau
- Talenan
- Wajan</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cabe rawit merah 
- cabe merah 
- bawang merah 
- bawang putih 
- kemiri
- kunyit 
- jahe 
- serai
- daun jeruk 
- daun pandan 
- daun kemangi 
- tomat 
- garam 
- minyak</NamaBahan>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Woku</NamaSambal>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pedas sedang, segar, gurih, dan sangat aromatik</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 10 cabe rawit merah 
- 5 cabe merah 
- 6 siung bawang merah 
- 3 siung bawang putih 
- 3 butir kemiri
- 2 cm kunyit 
- 2 cm jahe 
- 1 batang serai
- 3 lembar daun jeruk 
- 1 lembar daun pandan 
- 1 genggam daun kemangi 
- 1 buah tomat 
