        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cuci bersih cabe rawit, kupas bawnag merah

haluskan cabe wrawit, bawang merah, dan garam

panaskan minya, tumis sambal sampai wangi

angkat, tambahkan air perasan jeruk sambal 

hidangkan segera</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tulungagung, Jawa Timur</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses pembuatan sambal bledek memakan waktu sekitar 15 menit, meliputi 5 menit persiapan bahan, 5 menit pengulekan bumbu, dan 5 menit penumisan agar sambal lebih matang serta tahan lama.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">pisau
Cobek dan ulekan 
chopper  
panci 
wajan
spatula</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabai rawit, bawang merah, garam, jeruk sambal, minyak</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nasi 
bebek 
jerohan goreng</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Bledhek</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ditumis dan dichopper</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sangat Pedas</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 buah cabe rawit 
- 2 buah bawang merah 
- 1 sdt garam 
- 1 buah jeruk sambal 
- 3 sdm minyak</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah atau hijau</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalBledhek</rdfs:label>
    </owl:NamedIndividual>
    


