        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kukusan, Blender</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cabe rawit
- bawang putih
- kacang tanah goreng
- kencur
- daun jeruk purut
- santan kental matang
- garam
- gula merah
- air masak
- terong ungu</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi hangat dan aneka olahan protein nabati maupun hewani</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Terong Santan</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dikukus, Dibakar, Diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">gurih pekat (creamy), pedas, dan aroma segar yang kuat</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 buah cabe rawit
- 1 siung bawang putih
- 3 sdm kacang tanah goreng
- 1 ruas kencur
- 1 lembar daun jeruk purut
- 3 sdm santan kental matang
- 1/2 sdt garam
- 1/2 sdt gula merah
- 50ml air masak
- 1 buah terong ungu</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Halus, kental, lembut dan sedikit berserat</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">putih kemerahan atau merah muda (pink) pucat</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalTerongSantan</rdfs:label>
    </owl:NamedIndividual>
    


