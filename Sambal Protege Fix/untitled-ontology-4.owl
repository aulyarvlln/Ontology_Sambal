        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabe rawit
cabe merah
rebon udang
bawang merah
bawang putih</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi
Nasi Liwet</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Rebon</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bahan bahan di potong kasar lalu ditumis, kemudian dihaluskan dan dicampur dengan rebon yang sudah matang</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas Gurih</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 25 gr rebon (udang grago kering)
- 5 cabe merah
- 3 cabe rawit
- 3 bawang merah
- 1 siung bawang putih</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah Kecoklatan</WarnaSambal>
