        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cuci bersih cabe merah dan cabe rawit

kupas bawang merah, potong tipis

haluskan cabe merah, cabe rawit, bawang merah, dan terasi 

tambahkan saus tomat, garam, dan gula pasir

haluskan lalu tambahkan minyak, aduk rata

nyalakan kompor, bakar cobek beserta sambal yang telah dihalukan di atasnya sambai berbau harum

siap dihidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bontang, Kalimantan Timur</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses membuat sambal gami khas Bontang membutuhkan waktu total sekitar 15 hingga 20 menit, di mana waktu memasak dan membakar sambal langsung di atas cobek tanah liat berkisar antara 5 hingga 10 menit.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cobek tanah liat 
dan ulekan 
pisau 
talenan 
spatula
chopper</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabai besar merah, cabai rawit merah, bawang merah, terasi bakar, saos tomat, garam, gula pasir, minyak</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi
Ikan
Ayam
Udang
Cumi</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Gamie</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dimasak di atas cobek tanah liat langsung di atas kompor</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SangatPedas</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 buah cabe merah
- 7 buah cabe rawit 
- 2 buah bawang merah 
- 1/2 sdt terasi bakar 
- 1 sdm saus tomat 
- 1/2 sdt garam 
- 1/4 sdt gula pasir
- 1 sdm minyak</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Halus</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalGamie</rdfs:label>
    </owl:NamedIndividual>
    


