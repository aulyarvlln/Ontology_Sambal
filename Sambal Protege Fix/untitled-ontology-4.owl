        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R7Sk8sxZndEPi2wfz4ZSI3E"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R7lwQ8hIcyFVSKVE0emv0Td"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R8B7hX7t3IOdjt0zPDlG5BU"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R8hM3VlStaLMgQkFfteUEDV"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R9u3gKb2eSC7gvNrnyTJ2Ae"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/RCePgtR8ZVpJFflxdQdY3y1"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/RDcTRuR1cFUbhFq4l1jO8aM"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/ROQXxphpqrH4sulkZdjDuZ"/>
        <MenggunakanTeknikPemasakan rdf:resource="http://webprotege.stanford.edu/R79Rt0eqc2aNZhH17Jpm3Re"/>
        <MenggunakanTeknikPenghancuran rdf:resource="http://webprotege.stanford.edu/RDFmQFzRMZVtxEg06Q05DjX"/>
        <MenggunakanTeknikPenghancuran rdf:resource="http://webprotege.stanford.edu/RDSpv2dwyBNDaqWjwcH2DkZ"/>
        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cuci bersih cabe merah, cabe rawit, tomat, daun salam, dan serai 

Kupas bawang merah dan bawang putih

Potong-potong cabe merah, cabe rawit, bawang putih, bawang merah, dan tomat

Panaskan minyak, tumis semua bahan yang telah dipotong-potong, tambahkan terasi

Setelah harum, angkat dan haluskan bersama garam dan gula merah

Tumis kembali sambal, tambahkan daun salma dan serai yang telah dimemarkan sampai harum dan sedikit mengering

Sambal siap dinikmati atau disimpan dalam jangka waktu 1 minggu setelah pembuatan di suhu ruangan.</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jawa Tengah</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Persiapan dan menggoreng/merebus bahan awal sekitar 5 menit. Lalu menghaluskan bahan sekitar 2-3 menit dengan diulek. Lalu ditumis hingga tanak sekitar 10 menitan hingga berubah warna.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pisau,
talenan, 
wajan,
spatula, 
ulekan,
cobek dan ulekan 
blender</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabe merah, cabe rawit, bawang putih, bawang merah, tomat, daun salam , serai, terasi, garam, gula merah, minyak</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Nasi, telur rebus, bacem tahu-tempe, ikan goreng dan ayam goreng</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalBajak</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dimasak atau ditumis</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas Sedang</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 Cabe merah 
- 5 cabe rawit 
- 1 siung bawang putih 
- 2 buah bawang merah 
- 1 tomat masak
- 1 lembar daun salam 
- 1 batang serai 
- 1 sdt terasi 
- 1/2 sdt garam 
- 3 sdm gula merah 
- 3 sdm minyak</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Halus</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Merah Tua</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalBajak</rdfs:label>
    </owl:NamedIndividual>
    


