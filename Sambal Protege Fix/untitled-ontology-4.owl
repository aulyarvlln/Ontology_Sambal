        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R7fve9UKA4O66DLVOv3mLv9"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R7punmfT2i1wWmnpJz5nVa1"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R9u3gKb2eSC7gvNrnyTJ2Ae"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/R9vqEaByTQ3XisWuZLoTHTa"/>
        <MenggunakanBahanPenyedap rdf:resource="http://webprotege.stanford.edu/ROQXxphpqrH4sulkZdjDuZ"/>
        <MenggunakanTeknikPenghancuran rdf:resource="http://webprotege.stanford.edu/RDSpv2dwyBNDaqWjwcH2DkZ"/>
        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cuci bersih cabe lalap dan tomat, potong potong kasar
- kupas bawang merah, potongkasar
- letakkan potongan cabe lalap, tomat, dan bawang merah dalam mangkuk
- tambahkan garam dan merica bubuk
- aduk, tambahkan kecap manis dan air perasan jeruk nipis
- aduk rata lalu hidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indonesia</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sangat cepat, hanya membutuhkan waktu sekitar 3 hingga 5 menit karena semua bahannya cukup diiris atau diulek mentah lalu langsung disiram kecap manis.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pisau dan talenan</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabai lalap atau cabai rawit hijau, bawang merah, tomat, merica, garam, kecap manis, jeruk nipis</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sate kambing, sate ayam</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Sate</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diiris atau dipotong</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas sedang</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 cabe lalap 
- 3 bawang merah
- 1 buah tomat mengkal atau setengah masak
- 1/2 sdt merica bubuk
- 1/2 sdt garam 
- 50 ml kecap manis 
- 1/2 buah jeruk nipis, ambil airnya</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">coklat tua, kehitaman</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalSate</rdfs:label>
    </owl:NamedIndividual>
    


