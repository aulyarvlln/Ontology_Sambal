        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cuci bersih cabe merah, cabe rawit, daun jeruk, kemangi, dan lamtoro
- kupas lengkuas,
- haluskan cabe merah, cabe rawit, lengkuas, terasi bakar, garam, gula merah, dan daun jeruk purut
- tambahkan kelapa parut, aduk rata
- tambahkan kemangi, lamtoro, dan mentimun cincang, aduk
- siap dihidangkan</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jawa Tengah</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Proses membuat sambal trancam sangat cepat, hanya membutuhkan waktu sekitar 5 hingga 10 menit karena semua bahannya disajikan mentah tanpa perlu dimasak atau direbus sama sekali.</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cobek dan ulekan, chopper</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Cabai rawit, cabai merah tanpa biji, terasi, lengkuas, daun jeruk, garam, gula merah, kelapa parut, lamtoro kupas, mentimun cincang</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">nasi jagung, ikan asin, tahu goreng, tempe goreng</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Trancam</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dihaluskan menggunakan choper atau diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Pedas sedang</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 cabe rawit, 
- 1 cabe merah tanpa biji,
- 1/2 sdt terasi bakar
- 1/2 ruas jari lengkuas
- 1 lembar daun jeruk purut
- 1/2 sdt garam
- 1 sdt gula merah
- 3 sdm kelapa parut
- 1 sdm lamtoro kupas
- 1 sdm mentimun cincang</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Putih gading, putih kemerahan, kecoklatan</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalTrancam</rdfs:label>
