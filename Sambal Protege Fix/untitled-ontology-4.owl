cobek
ulekan
chopper</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cabe rawit 
- bawang putih 
- kacang tanah goreng 
- petis ikan 
- gula merah 
- terasi goreng
- pisang batu muda
- air matang</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lontong dan sayuran rebus</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Rujak Madura</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diulek</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">paduan rasa manis gurih yang legit, pedas menggigit, dengan aroma dan rasa gurih laut (seafood) yang sangat kuat</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 3 buah cabe rawit 
- 1 siung bawang putih 
- 3 sdm kacang tanah goreng 
- 1 sdm petis ikan 
- 1 sdm gula merah 
- 1/2 sdt terasi goreng
- 1/2 buah pisang batu muda
- 50 ml air matang</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">sangat kental, lengket, dan agak mulur (stretchy), hampir menyerupai selai padat atau karamel basah</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">cokelat tua kehitaman, cokelat kemerahan, hingga cokelat muda mengilap,</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalRujakMadura</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/aulia/ontologies/2026/8/untitled-ontology-4#SambalSate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/aulia/ontologies/2026/8/untitled-ontology-4#SambalSate">
        <rdf:type rdf:resource="http://www.semanticweb.org/aulia/ontologies/2026/8/untitled-ontology-4#SambalMentah"/>
