        <webprotege:R7wlyRB7ID3Ps1xfcTJH2ai rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cuci bersih cabe keriting dan cabe rawit

- kupas bawang merah lalu potong kasar

-haluskan cabe keriting, cabe rawit, bawang merah, terasi, garam, dan gula

- kucuri air jeruk sambal, aduk rata

-tuangkan minyak panas dan aduk kembali lalu hidangkan segara</webprotege:R7wlyRB7ID3Ps1xfcTJH2ai>
        <AsalDaerah rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jawa Barat</AsalDaerah>
        <LamaProses rdf:datatype="http://www.w3.org/2001/XMLSchema#string">10 sampai 15 menit</LamaProses>
        <NamaAlat rdf:datatype="http://www.w3.org/2001/XMLSchema#string">talenan, pisau, ulekan, Blender, wajan</NamaAlat>
        <NamaBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- cabe keriting
- cabe rawit
- terasi udang goreng
- bawang merah
- garam
- gula merah
- jeruk sambal
- minyak panas</NamaBahan>
        <NamaSajian rdf:datatype="http://www.w3.org/2001/XMLSchema#string">udang goreng, ikan goreng atau tempe tahu goreng</NamaSajian>
        <NamaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sambal Terasi</NamaSambal>
        <NamaTeknik rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diulek, Digoreng, Ditumis</NamaTeknik>
        <RasaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perpaduan antara pedas, gurih-asin, sedikit manis, dan aroma umami yang pekat</RasaSambal>
        <TakaranBahan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">- 5 cabe keriting
- 3 cabe rawit
- 1 sdt terasi udang goreng
- 1 buah bawang merah
- 1/2 sdt garam
- 1/2 sdt gula merah
- 1 buah jeruk sambal
- 1 sdm minyak panas</TakaranBahan>
        <TeksturSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kasar bisa halus bisa (sesuai selera)</TeksturSambal>
        <WarnaSambal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">merah tua, merah kecokelatan, hingga cokelat pekat</WarnaSambal>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">SambalTerasi</rdfs:label>
    </owl:NamedIndividual>
    


